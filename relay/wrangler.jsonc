{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "levemetes-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RelayRoom" },
      { "name": "DIRECTORY", "class_name": "RoomDirectory" }
    ]
  },
  "r2_buckets": [
    { "binding": "DECKS", "bucket_name": "levemetes-room-decks" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayRoom", "RoomDirectory"] }
  ],
  "observability": { "enabled": true }
}
